import streamlit as st
import streamlit.components.v1 as components

st.set_page_config(
    page_title="Smart Shop & Discount",
    layout="wide"
)

html_code = r"""
<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Smart Shop & Discount</title>

<script src="https://cdn.tailwindcss.com"></script>

<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
>

<link
    href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
>

<style>
body {
    font-family: 'Kanit', sans-serif;
}
</style>

</head>

<body class="bg-slate-100 min-h-screen text-slate-800">

<!-- HEADER -->
<nav class="bg-indigo-600 text-white shadow-md">

    <div class="max-w-7xl mx-auto px-4 py-3
                flex justify-between items-center">

        <div class="flex items-center gap-3">

            <i class="fa-solid fa-store text-2xl"></i>

            <h1 class="text-xl font-bold">
                Smart Shop & Discount
            </h1>

        </div>

        <div class="text-sm">
            <span
                id="current-date"
                class="bg-indigo-700 px-3 py-1 rounded-full"
            ></span>
        </div>

    </div>

</nav>


<!-- MAIN -->
<div class="max-w-7xl mx-auto p-4
            grid grid-cols-1 lg:grid-cols-12 gap-6">


    <!-- LEFT -->
    <div class="lg:col-span-7 space-y-6">


        <!-- ADD PRODUCT -->
        <div class="bg-white p-5 rounded-xl shadow-sm
                    border border-slate-200">

            <h2 class="text-lg font-semibold mb-4 text-indigo-900">

                <i class="fa-solid fa-cart-plus mr-2"></i>

                เพิ่มรายการสินค้าด่วน

            </h2>


            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">

                <input
                    type="text"
                    id="custom-name"
                    placeholder="ชื่อสินค้า"
                    class="p-2.5 border rounded-lg outline-none"
                >

                <input
                    type="number"
                    id="custom-price"
                    placeholder="ราคา (บาท)"
                    min="0"
                    step="0.01"
                    class="p-2.5 border rounded-lg outline-none"
                >

                <button
                    onclick="addCustomProduct()"
                    class="bg-indigo-600 hover:bg-indigo-700
                           text-white font-medium
                           py-2.5 px-4 rounded-lg"
                >

                    <i class="fa-solid fa-plus mr-1"></i>

                    เพิ่มลงตะกร้า

                </button>

            </div>

        </div>


        <!-- QUICK PRODUCTS -->
        <div class="bg-white p-5 rounded-xl shadow-sm
                    border border-slate-200">

            <h2 class="text-lg font-semibold mb-4 text-indigo-900">

                <i class="fa-solid fa-boxes-stacked mr-2"></i>

                เมนูลัดประจำร้าน

            </h2>

            <div
                id="quick-catalog"
                class="grid grid-cols-2 sm:grid-cols-3 gap-3"
            ></div>

        </div>


        <!-- SALES -->
        <div class="bg-white p-5 rounded-xl shadow-sm
                    border border-slate-200">

            <div class="flex justify-between items-center mb-4">

                <h2 class="text-lg font-semibold text-indigo-900">

                    <i class="fa-solid fa-chart-line mr-2"></i>

                    สรุปยอดขาย

                </h2>

                <button
                    onclick="clearHistory()"
                    class="text-xs text-red-500 hover:underline"
                >
                    ล้างประวัติ
                </button>

            </div>


            <div class="grid grid-cols-2 gap-4 text-center">

                <div class="bg-indigo-50 p-3 rounded-lg">

                    <div class="text-xs text-indigo-600">
                        จำนวนบิล
                    </div>

                    <div
                        id="total-bills"
                        class="text-2xl font-bold text-indigo-900"
                    >
                        0
                    </div>

                </div>


                <div class="bg-emerald-50 p-3 rounded-lg">

                    <div class="text-xs text-emerald-600">
                        ยอดขายรวม
                    </div>

                    <div
                        id="total-sales-amount"
                        class="text-2xl font-bold text-emerald-900"
                    >
                        ฿0.00
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- RIGHT -->
    <div class="lg:col-span-5">

        <div class="bg-white p-5 rounded-xl shadow-sm
                    border border-slate-200">


            <!-- CART HEADER -->
            <div class="flex justify-between items-center
                        mb-4 border-b pb-3">

                <h2 class="text-lg font-bold">

                    <i class="fa-solid fa-receipt
                              mr-2 text-indigo-600"></i>

                    ตะกร้าสินค้า

                </h2>


                <button
                    onclick="clearCart()"
                    class="text-xs text-red-500"
                >
                    ล้างตะกร้า
                </button>

            </div>


            <!-- CART -->
            <div
                id="cart-items"
                class="max-h-64 overflow-y-auto divide-y mb-4"
            >

                <p class="text-slate-400 text-center py-8 text-sm">
                    ยังไม่มีสินค้าในตะกร้า
                </p>

            </div>


            <!-- TOTAL -->
            <div class="space-y-4 border-t pt-4">


                <!-- SUBTOTAL -->
                <div class="flex justify-between">

                    <span class="text-slate-600">
                        ราคารวม
                    </span>

                    <span id="subtotal">
                        ฿0.00
                    </span>

                </div>


                <!-- DISCOUNT -->
                <div class="bg-amber-50 p-3 rounded-lg">

                    <div class="text-xs font-medium
                                text-amber-900 mb-2">

                        ส่วนลด

                    </div>


                    <div class="flex gap-2">

                        <select
                            id="discount-type"
                            onchange="updateTotal()"
                            class="p-2 border rounded-lg bg-white"
                        >

                            <option value="percent">
                                %
                            </option>

                            <option value="flat">
                                บาท
                            </option>

                        </select>


                        <input
                            type="number"
                            id="discount-value"
                            value="0"
                            min="0"
                            step="0.01"
                            oninput="updateTotal()"
                            class="p-2 border rounded-lg
                                   bg-white w-full"
                        >

                    </div>

                </div>


                <!-- VAT -->
                <div class="flex justify-between items-center">

                    <label class="flex gap-2 items-center">

                        <input
                            type="checkbox"
                            id="vat-toggle"
                            onchange="updateTotal()"
                        >

                        <span>
                            VAT 7%
                        </span>

                    </label>


                    <span id="vat-amount">
                        ฿0.00
                    </span>

                </div>


                <!-- GRAND TOTAL -->
                <div
                    class="flex justify-between items-center
                           border-t pt-3"
                >

                    <span class="font-bold text-lg">
                        ยอดสุทธิ
                    </span>

                    <span
                        id="grand-total"
                        class="text-2xl font-bold
                               text-indigo-600"
                    >
                        ฿0.00
                    </span>

                </div>


                <!-- CASH -->
                <div class="border-t pt-4">

                    <label
                        class="text-xs text-slate-600"
                    >
                        รับเงิน
                    </label>


                    <input
                        type="number"
                        id="cash-received"
                        placeholder="0.00"
                        min="0"
                        step="0.01"
                        oninput="calculateChange()"
                        class="mt-1 p-3 border rounded-lg
                               w-full text-lg font-bold"
                    >


                    <div class="grid grid-cols-4 gap-1 mt-2">

                        <button
                            onclick="quickCash('exact')"
                            class="bg-slate-200 py-2 rounded"
                        >
                            พอดี
                        </button>

                        <button
                            onclick="quickCash(100)"
                            class="bg-slate-200 py-2 rounded"
                        >
                            100
                        </button>

                        <button
                            onclick="quickCash(500)"
                            class="bg-slate-200 py-2 rounded"
                        >
                            500
                        </button>

                        <button
                            onclick="quickCash(1000)"
                            class="bg-slate-200 py-2 rounded"
                        >
                            1000
                        </button>

                    </div>

                </div>


                <!-- CHANGE -->
                <div
                    class="flex justify-between items-center
                           bg-emerald-50 p-3 rounded-lg"
                >

                    <span class="font-bold">
                        เงินทอน
                    </span>

                    <span
                        id="change-amount"
                        class="text-xl font-bold
                               text-slate-400"
                    >
                        ฿0.00
                    </span>

                </div>


                <!-- CHECKOUT -->
                <button
                    onclick="checkout()"
                    class="w-full bg-emerald-600
                           hover:bg-emerald-700
                           text-white font-bold
                           py-3 rounded-lg"
                >

                    <i class="fa-solid fa-check-circle mr-2"></i>

                    จบการขาย

                </button>

            </div>

        </div>

    </div>

</div>


<script>

/* =========================
   DATA
========================= */

const products = [
    {
        name: "กาแฟอเมริกาโน่",
        price: 50,
        icon: "fa-coffee"
    },
    {
        name: "ชาไทยเย็น",
        price: 45,
        icon: "fa-glass-water"
    },
    {
        name: "เค้กช็อกโกแลต",
        price: 85,
        icon: "fa-cake-candles"
    },
    {
        name: "ครัวซองต์",
        price: 60,
        icon: "fa-bread-slice"
    },
    {
        name: "น้ำเปล่า",
        price: 10,
        icon: "fa-bottle-water"
    }
];


let cart = [];

let salesHistory = [];

try {

    salesHistory =
        JSON.parse(
            localStorage.getItem("salesHistory")
        ) || [];

} catch (error) {

    salesHistory = [];

}


/* =========================
   START
========================= */

document.addEventListener(
    "DOMContentLoaded",
    function() {

        document.getElementById(
            "current-date"
        ).innerText =
            new Date().toLocaleDateString("th-TH");


        renderProducts();

        renderCart();

        updateHistory();

    }
);


/* =========================
   PRODUCTS
========================= */

function renderProducts() {

    const container =
        document.getElementById(
            "quick-catalog"
        );


    container.innerHTML = "";


    products.forEach(function(product, index) {

        const button =
            document.createElement("button");


        button.className =
            "p-3 border rounded-xl bg-slate-50 " +
            "hover:bg-indigo-50 " +
            "hover:border-indigo-300 " +
            "text-left h-20";


        button.innerHTML =

            '<div class="font-medium text-xs">' +

            '<i class="fa-solid ' +
            product.icon +
            ' text-indigo-500 mr-1"></i>' +

            product.name +

            '</div>' +

            '<div class="text-sm font-bold ' +
            'text-indigo-600 mt-2">' +

            "฿" +
            product.price.toFixed(2) +

            "</div>";


        button.onclick = function() {

            addToCart(
                product.name,
                product.price
            );

        };


        container.appendChild(button);

    });

}


/* =========================
   ADD TO CART
========================= */

function addToCart(name, price) {

    const existing =
        cart.find(function(item) {

            return (
                item.name === name &&
                item.price === Number(price)
            );

        });


    if (existing) {

        existing.qty += 1;

    } else {

        cart.push({
            name: name,
            price: Number(price),
            qty: 1
        });

    }


    renderCart();

}


/* =========================
   CUSTOM PRODUCT
========================= */

function addCustomProduct() {

    const name =
        document.getElementById(
            "custom-name"
        ).value.trim();


    const price =
        parseFloat(
            document.getElementById(
                "custom-price"
            ).value
        );


    if (
        name === "" ||
        isNaN(price) ||
        price <= 0
    ) {

        alert(
            "กรุณากรอกชื่อสินค้าและราคาให้ถูกต้อง"
        );

        return;

    }


    addToCart(name, price);


    document.getElementById(
        "custom-name"
    ).value = "";


    document.getElementById(
        "custom-price"
    ).value = "";

}


/* =========================
   RENDER CART
========================= */

function renderCart() {

    const container =
        document.getElementById(
            "cart-items"
        );


    if (cart.length === 0) {

        container.innerHTML =
            '<p class="text-slate-400 ' +
            'text-center py-8 text-sm">' +
            'ยังไม่มีสินค้าในตะกร้า' +
            '</p>';

        updateTotal();

        return;

    }


    container.innerHTML = "";


    cart.forEach(function(item, index) {

        const row =
            document.createElement("div");


        row.className =
            "py-3 flex justify-between items-center";


        const left =
            document.createElement("div");

        left.className =
            "flex-1";


        left.innerHTML =
            '<div class="font-medium">' +
            escapeHtml(item.name) +
            '</div>' +

            '<div class="text-xs text-slate-500">' +
            "฿" +
            item.price.toFixed(2) +
            " × " +
            item.qty +
            "</div>";


        const controls =
            document.createElement("div");


        controls.className =
            "flex items-center gap-2";


        const minus =
            document.createElement("button");

        minus.innerText = "-";

        minus.className =
            "w-7 h-7 bg-slate-200 rounded-full";

        minus.onclick = function() {

            updateQty(index, -1);

        };


        const qty =
            document.createElement("span");

        qty.innerText = item.qty;

        qty.className =
            "w-5 text-center font-bold";


        const plus =
            document.createElement("button");

        plus.innerText = "+";

        plus.className =
            "w-7 h-7 bg-slate-200 rounded-full";

        plus.onclick = function() {

            updateQty(index, 1);

        };


        const total =
            document.createElement("span");

        total.innerText =
            "฿" +
            (item.price * item.qty).toFixed(2);

        total.className =
            "font-bold w-20 text-right";


        controls.appendChild(minus);

        controls.appendChild(qty);

        controls.appendChild(plus);

        controls.appendChild(total);


        row.appendChild(left);

        row.appendChild(controls);


        container.appendChild(row);

    });


    updateTotal();

}


/* =========================
   ESCAPE HTML
========================= */

function escapeHtml(text) {

    const div =
        document.createElement("div");

    div.textContent = text;

    return div.innerHTML;

}


/* =========================
   UPDATE QTY
========================= */

function updateQty(index, amount) {

    if (!cart[index]) {
        return;
    }


    cart[index].qty += amount;


    if (cart[index].qty <= 0) {

        cart.splice(index, 1);

    }


    renderCart();

}


/* =========================
   CLEAR CART
========================= */

function clearCart() {

    cart = [];


    document.getElementById(
        "discount-value"
    ).value = 0;


    document.getElementById(
        "cash-received"
    ).value = "";


    document.getElementById(
        "vat-toggle"
    ).checked = false;


    renderCart();

}


/* =========================
   CALCULATE TOTAL
========================= */

function calculateTotal() {

    let subtotal = 0;


    cart.forEach(function(item) {

        subtotal +=
            item.price * item.qty;

    });


    const discountType =
        document.getElementById(
            "discount-type"
        ).value;


    let discountValue =
        parseFloat(
            document.getElementById(
                "discount-value"
            ).value
        ) || 0;


    if (discountValue < 0) {

        discountValue = 0;

    }


    let discount = 0;


    if (discountType === "percent") {

        if (discountValue > 100) {

            discountValue = 100;

        }


        discount =
            subtotal *
            discountValue /
            100;

    } else {

        discount =
            Math.min(
                discountValue,
                subtotal
            );

    }


    const afterDiscount =
        subtotal - discount;


    const vatEnabled =
        document.getElementById(
            "vat-toggle"
        ).checked;


    const vat =
        vatEnabled
            ? afterDiscount * 0.07
            : 0;


    const total =
        afterDiscount + vat;


    return {
        subtotal: subtotal,
        discount: discount,
        vat: vat,
        total: total
    };

}


/* =========================
   UPDATE TOTAL
========================= */

function updateTotal() {

    const result =
        calculateTotal();


    document.getElementById(
        "subtotal"
    ).innerText =
        "฿" +
        result.subtotal.toFixed(2);


    document.getElementById(
        "vat-amount"
    ).innerText =
        "฿" +
        result.vat.toFixed(2);


    document.getElementById(
        "grand-total"
    ).innerText =
        "฿" +
        result.total.toFixed(2);


    calculateChange();

}


/* =========================
   CHANGE
========================= */

function calculateChange() {

    const result =
        calculateTotal();


    const cash =
        parseFloat(
            document.getElementById(
                "cash-received"
            ).value
        ) || 0;


    const changeElement =
        document.getElementById(
            "change-amount"
        );


    if (
        cart.length === 0 ||
        cash < result.total
    ) {

        changeElement.innerText =
            "฿0.00";

        changeElement.className =
            "text-xl font-bold text-red-500";

        return;

    }


    const change =
        cash - result.total;


    changeElement.innerText =
        "฿" +
        change.toFixed(2);


    changeElement.className =
        "text-xl font-bold text-emerald-600";

}


/* =========================
   QUICK CASH
========================= */

function quickCash(amount) {

    const result =
        calculateTotal();


    let cash = 0;


    if (amount === "exact") {

        cash = result.total;

    } else {

        cash = Number(amount);

    }


    document.getElementById(
        "cash-received"
    ).value =
        cash.toFixed(2);


    calculateChange();

}


/* =========================
   CHECKOUT
========================= */

function checkout() {

    if (cart.length === 0) {

        alert(
            "กรุณาเลือกสินค้าอย่างน้อย 1 รายการ"
        );

        return;

    }


    const result =
        calculateTotal();


    const cash =
        parseFloat(
            document.getElementById(
                "cash-received"
            ).value
        ) || 0;


    if (cash < result.total) {

        alert(
            "จำนวนเงินที่รับมาไม่เพียงพอ"
        );

        return;

    }


    const transaction = {

        id: Date.now(),

        date:
            new Date().toLocaleString(
                "th-TH"
            ),

        total:
            result.total

    };


    salesHistory.push(
        transaction
    );


    try {

        localStorage.setItem(
            "salesHistory",
            JSON.stringify(
                salesHistory
            )
        );

    } catch (error) {

        console.error(error);

    }


    updateHistory();


    const change =
        cash - result.total;


    alert(
        "บันทึกการขายสำเร็จ\\n\\n" +
        "ยอดสุทธิ: ฿" +
        result.total.toFixed(2) +
        "\\n" +
        "รับเงิน: ฿" +
        cash.toFixed(2) +
        "\\n" +
        "เงินทอน: ฿" +
        change.toFixed(2)
    );


    clearCart();

}


/* =========================
   HISTORY
========================= */

function updateHistory() {

    document.getElementById(
        "total-bills"
    ).innerText =
        salesHistory.length;


    let total = 0;


    salesHistory.forEach(
        function(item) {

            total +=
                Number(item.total) || 0;

        }
    );


    document.getElementById(
        "total-sales-amount"
    ).innerText =
        "฿" +
        total.toFixed(2);

}


/* =========================
   CLEAR HISTORY
========================= */

function clearHistory() {

    if (
        !confirm(
            "ต้องการล้างประวัติการขายทั้งหมดหรือไม่?"
        )
    ) {

        return;

    }


    salesHistory = [];


    localStorage.removeItem(
        "salesHistory"
    );


    updateHistory();

}

</script>

</body>
</html>
"""


components.html(
    html_code,
    height=900,
    scrolling=True
)
